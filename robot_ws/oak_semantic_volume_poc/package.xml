  <description>ROS 2 Foxy proof of concept for OAK on-device segmentation and semantic viewing-volume fusion with LiDAR occupancy.</description>
  <maintainer email="andy@example.com">Andy</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
